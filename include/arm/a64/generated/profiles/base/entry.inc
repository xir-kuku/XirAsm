            } else {
                a64x_precache(args, "abs", numbers)
                selected = a64x_legacy_abs_key(a64x_parse_cached(args, "abs", true, numbers), key)
            }
            if list.get(selected, 0) {
                emit.u32(list.get(selected, 1))
                emitted = true
            }
        }
    }
    if !emitted && !source_tried {
        const fallback: list = a64x_source_abs_cached(args, numbers)
        if list.get(fallback, 0) {
            emit.u32(list.get(fallback, 1))
            emitted = true
        }
    }
    assert(emitted, "a64 abs: invalid operand classes, arrangements, count or value")
}

