    let numbers: list = list.new()
    let source_tried: bool = false
    if !a64x_legacy_simple(args) {
        source_tried = true
        const source: list = a64x_source_abs_cached(args, numbers)
        numbers = list.get(source, 3)
        if list.get(source, 0) {
            emit.u32(list.get(source, 1))
            emitted = true
        }
    }
    if !emitted {
        const literal: bool = a64x_literal_args(args)
        const shaped: list = a64x_parse_cached(args, "abs", literal, numbers)
        const key: u64 = a64x_signature(shaped)
        if key == 1055751 || key == 1057801 || key == 1058826 || key == 1059851 || key == 1060876 || key == 1061901 || key == 1062926 || key == 1064976 {
            let selected: list = list.of(false, 0, 0)
