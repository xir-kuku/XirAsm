fn a64x_number(arg: operand) -> integer {
    return operand.eval(a64_number(arg));
}

fn a64x_legacy_simple(args: list) -> bool {
    for raw in args {
        const text: string = lower(trim(operand.text(raw)))
        if ends_with(text, "nxs") {
            const parts: list = tokens.of(text)
            if len(parts) > 0 && list.get(parts, len(parts) - 1) == "nxs" {
                return false;
            }
        }
        if starts_with(text, "za") || starts_with(text, "pn") || starts_with(text, "{") && contains(text, "za") || starts_with(text, "[") && (contains(text, "z") || contains(text, "mul")) {
            return false;
        }
    }
    return true;
}

fn a64x_literal_args(args: list) -> bool {
    // Only fixed architecture spelling and integer tokens may skip invocation memoization.
    for raw in args {
        const text: string = lower(trim(operand.text(raw)))
        if contains(text, "(") || contains(text, ")") {
            return false;
        }
        if !map.has(a64x_registers, text) {
            for token in tokens.of(replace(text, "#", " ")) {
                if !map.has(a64x_registers, token) && !map.has(a64x_literal_tokens, token) {
                    const literal: map = match.tokens("value:int", token)
                    if !map.get(literal, "ok") {
                        return false;
                    }
                }
            }
        }
    }
    return true;
}

fn a64x_slot(table: map, mnemonic: string, index: u64) -> bool {
    if !map.has(table, mnemonic) {
        return false;
    }
    return ((map.get(table, mnemonic) >> index) & 1) != 0;
}

fn a64x_lookup(value: integer, choices: list) -> u64 {
    let index: u64 = 0
    for choice in choices {
        if value == choice {
            return index;
        }
        index = index + 1
    }
    return 0xffffffffffffffff;
}

fn a64x_stretched(value: u64) -> u64 {
    let result: u64 = 0
    let index: u64 = 0
    while index < 8 {
        const byte: u64 = (value >> (index * 8)) & 255
        if byte != 0 && byte != 255 {
            return 0xffffffffffffffff;
        }
        if byte == 255 {
            result = result | (1 << index)
        }
        index = index + 1
    }
    return result;
}

fn a64x_signature(flat: list) -> u64 {
    assert(len(flat) <= 6, "a64: invalid operand count")
    let key: u64 = 1
    for descriptor in flat {
        let kind: string = list.get(descriptor, 0)
        if kind == "target" || kind == "fpzero" {
            kind = "imm"
        }
        if !map.has(a64x_kind_tags, kind) {
            return 0;
        }
        let count: u64 = 0
        if len(descriptor) > 2 {
            count = list.get(descriptor, 2)
        }
        assert(count <= 4, "a64: register list length out of range")
        key = key * 1024 + map.get(a64x_kind_tags, kind) + count * 128
    }
    return key;
}

fn a64x_named(name: string, mnemonic: string) -> list {
    const key: string = sym.join(mnemonic, "|", lower(trim(name)))
    if map.has(a64x_names, key) {
        return map.get(a64x_names, key);
    }
    return list.new();
}

fn a64x_sysreg(arg: operand, access: u64, evaluate: bool, numbers: list, raw: operand, argindex: u64) -> list {
    const name: string = lower(trim(operand.text(arg)))
    if map.has(a64x_system_registers, name) {
        const entry: list = map.get(a64x_system_registers, name)
        assert((list.get(entry, 1) & access) != 0, "a64: invalid system register access")
        return list.of("sysreg", list.get(entry, 0), 0);
    }
    if starts_with(name, "sysreg ") {
        return list.of("sysreg", a64x_value(operand.slice(arg, 7, len(name)), evaluate, numbers, raw, argindex), 0);
    }
    const old: list = a64_sysreg(name)
    return list.of("sysreg", list.get(old, 1), 0);
}

fn a64x_from_legacy(args: list, mnemonic: string) -> list {
    const flat: list = a64_flatten(args)
    let result: list = list.new()
    for descriptor in flat {
        const tag: u64 = list.get(descriptor, 0)
        assert(tag < len(a64x_old_kinds), "a64: unsupported operand descriptor")
        let kind: string = list.get(a64x_old_kinds, tag)
        const value: integer = list.get(descriptor, 1)
        let count: u64 = 0
        if len(descriptor) > 2 {
            count = list.get(descriptor, 2)
        }
        if kind == "name" {
            const key: string = sym.join("", value)
            assert(map.has(a64x_old_names, key), "a64: unknown system operand descriptor")
            const named: list = a64x_named(map.get(a64x_old_names, key), mnemonic)
            assert(len(named) != 0, "a64: invalid system operand context")
            list.push_mut(result, named)
        } else {
            list.push_mut(result, list.of(kind, value, count))
        }
    }
    return result;
}

fn a64x_list(arg: operand) -> list {
    const clean: operand = a64_clean(arg)
    const text: string = lower(operand.text(clean))
    assert(starts_with(text, "{") && ends_with(text, "}"), "a64: invalid register list")
    const parts: list = operand.split(operand.slice(clean, 1, len(text) - 1))
    assert(len(parts) > 0 && len(parts) <= 4, "a64: register list requires one to four members")
    let first: list = list.new()
    let count: u64 = 0
    if len(parts) == 1 && contains(operand.text(list.get(parts, 0)), "-") {
        const endpoints: list = split(operand.text(list.get(parts, 0)), "-")
        assert(len(endpoints) == 2, "a64: invalid register range")
        first = a64x_register(list.get(endpoints, 0))
        const last: list = a64x_register(list.get(endpoints, 1))
        assert(len(first) == 2 && len(last) == 2 && list.get(first, 0) == list.get(last, 0), "a64: mismatched register range")
        count = ((list.get(last, 1) + 32 - list.get(first, 1)) & 31) + 1
        assert(count <= 4, "a64: register range exceeds four members")
    } else {
        for part in parts {
            const reg: list = a64x_register(operand.text(part))
            assert(len(reg) == 2, "a64: invalid register list member")
            if count == 0 {
                first = reg
            } else {
                assert(list.get(reg, 0) == list.get(first, 0) && list.get(reg, 1) == ((list.get(first, 1) + count) & 31), "a64: register list must be consecutive with matching arrangements")
            }
            count = count + 1
        }
    }
    return list.of(list.get(first, 0), list.get(first, 1), count);
}

fn a64x_cache_key(argindex: u64, start: u64, end: u64) -> string {
    return sym.join(argindex, ":", start, ":", end);
}

fn a64x_cache_span(raw: operand, arg: operand, argindex: u64) -> string {
    const clean: operand = a64_number(arg)
    const needle: string = operand.text(clean)
    const text: string = operand.text(raw)
    let start: u64 = 0
    let found: bool = false
    let selected: u64 = 0
    while start + len(needle) <= len(text) {
        if operand.text(operand.slice(raw, start, start + len(needle))) == needle {
            found = true
            selected = start
        }
        start = start + 1
    }
    assert(found, "a64: captured numeric span does not belong to its operand")
    return a64x_cache_key(argindex, selected, selected + len(needle));
}

fn a64x_cached_number(numbers: list, raw: operand, arg: operand, argindex: u64) -> integer {
    const clean: operand = a64_number(arg)
    if len(numbers) == 0 {
        return operand.eval(clean);
    }
    const key: string = a64x_cache_span(raw, clean, argindex)
    for pair in numbers {
        if list.get(pair, 0) == key {
            return list.get(pair, 1);
        }
    }
    return a64x_number(clean);
}

fn a64x_cached_float(numbers: list, raw: operand, arg: operand, argindex: u64) -> f64 {
    const clean: operand = a64_number(arg)
    if len(numbers) == 0 {
        return operand.eval(clean);
    }
    const key: string = a64x_cache_span(raw, clean, argindex)
    for pair in numbers {
        if list.get(pair, 0) == key {
            return list.get(pair, 1);
        }
    }
    return operand.eval(clean);
}

fn a64x_precache_one(raw: operand, arg: operand, argindex: u64, let numbers: list) {
    const clean: operand = a64_number(arg)
    const key: string = a64x_cache_span(raw, clean, argindex)
    let found: bool = false
    for pair in numbers {
        if list.get(pair, 0) == key {
            found = true
        }
    }
    if !found {
        list.push_mut(numbers, list.of(key, operand.eval(clean)))
    }
}

fn a64x_precache(args: list, mnemonic: string, let numbers: list) {
    let slot: u64 = 0
    let argindex: u64 = 0
    for raw in args {
        const arg: operand = a64_clean(raw)
        const text: string = operand.text(arg)
        const name: string = lower(text)
        const reg: list = a64x_register(name)
        const named: list = a64x_named(name, mnemonic)
        if len(reg) != 0 || len(named) != 0 || map.has(a64_conditions, name) || a64_is_prefetch(name) || contains(name, "/") && starts_with(name, "p") {
            slot = slot + 1
        } else if (mnemonic == "mrs" && slot == 1) || (mnemonic == "msr" && slot == 0) {
            if starts_with(name, "sysreg ") {
                a64x_precache_one(raw, operand.slice(arg, 7, len(text)), argindex, numbers)
            }
            slot = slot + 1
        } else if starts_with(name, "[") {
            let end: u64 = len(text) - 1
            if ends_with(name, "]!") {
                end = end - 1
            }
            const pieces: list = operand.split(operand.slice(arg, 1, end))
            if len(pieces) >= 2 {
                const offset: operand = a64_clean(list.get(pieces, 1))
                const index: list = a64x_register(operand.text(offset))
                if len(index) == 0 && !contains(operand.text(offset), ":lo12:") {
                    a64x_precache_one(raw, offset, argindex, numbers)
                }
            }
            if len(pieces) >= 3 {
                const modifier: operand = a64_clean(list.get(pieces, 2))
                const width: u64 = a64_modifier_prefix(lower(operand.text(modifier)))
                if width != 0 && len(operand.text(modifier)) > width {
                    a64x_precache_one(raw, operand.slice(modifier, width, len(operand.text(modifier))), argindex, numbers)
                }
            }
            slot = slot + 2
        } else if starts_with(name, "za.") && contains(name, "[") {
            const pieces: list = split(name, "[")
            const body: operand = operand.slice(arg, len(list.get(pieces, 0)) + 1, len(text) - 1)
            const parts: list = operand.split(body)
            a64x_precache_one(raw, list.get(parts, 1), argindex, numbers)
            slot = slot + 3
        } else if contains(name, "[") && (starts_with(name, "v") || starts_with(name, "{")) {
            const pieces: list = split(name, "[")
            a64x_precache_one(raw, operand.slice(arg, len(list.get(pieces, 0)) + 1, len(text) - 1), argindex, numbers)
            slot = slot + 2
        } else if starts_with(name, "{") {
            slot = slot + 1
        } else if a64_modifier_prefix(name) != 0 {
            const width: u64 = a64_modifier_prefix(name)
            if len(text) > width {
                a64x_precache_one(raw, operand.slice(arg, width, len(text)), argindex, numbers)
            }
            slot = slot + 1
        } else if !a64x_slot(a64x_target_slots, mnemonic, slot) || starts_with(name, "#") {
            a64x_precache_one(raw, arg, argindex, numbers)
            slot = slot + 1
        } else {
            slot = slot + 1
        }
        argindex = argindex + 1
    }
}

fn a64x_value(arg: operand, evaluate: bool, numbers: list, raw: operand, argindex: u64) -> integer {
    if evaluate {
        return a64x_cached_number(numbers, raw, arg, argindex);
    }
    return 0;
}

fn a64x_parse(args: list, mnemonic: string, evaluate: bool) -> list {
    return a64x_parse_cached(args, mnemonic, evaluate, list.new());
}

fn a64x_parse_cached(args: list, mnemonic: string, evaluate: bool, numbers: list) -> list {
    assert(len(args) <= 6, "a64: invalid operand count")
    let result: list = list.new()
    let argindex: u64 = 0
    for raw in args {
        const arg: operand = a64_clean(raw)
        const text: string = operand.text(arg)
        const name: string = lower(text)
        const slot: u64 = len(result)
        const named: list = a64x_named(name, mnemonic)
        const reg: list = a64x_register(name)
        let pstate_register: bool = false
        if mnemonic == "msr" && slot == 0 && len(args) == 2 {
            const source: list = a64x_register(operand.text(list.get(args, 1)))
            pstate_register = len(source) != 0
        }
        if len(named) != 0 && !pstate_register {
            list.push_mut(result, named)
        } else if (mnemonic == "mrs" && slot == 1) || (mnemonic == "msr" && slot == 0) {
            let access: u64 = 1
            if mnemonic == "msr" {
                access = 2
            }
            list.push_mut(result, a64x_sysreg(arg, access, evaluate, numbers, raw, argindex))
        } else if len(reg) != 0 {
            let kind: string = list.get(reg, 0)
            if kind == "xzr" {
                kind = "x"
            }
            if kind == "wzr" {
                kind = "w"
            }
            list.push_mut(result, list.of(kind, list.get(reg, 1), 0))
        } else if contains(name, "/") && starts_with(name, "p") {
            const parts: list = split(name, "/")
            assert(len(parts) == 2, "a64: invalid predicate qualifier")
            const pred: list = a64x_register(list.get(parts, 0))
            const mode: string = trim(list.get(parts, 1))
            assert(len(pred) == 2 && list.get(pred, 0) == "p" && (mode == "m" || mode == "z"), "a64: invalid predicate qualifier")
            list.push_mut(result, list.of(sym.join("pg_", mode), list.get(pred, 1), 0))
        } else if map.has(a64_conditions, name) {
            list.push_mut(result, list.of("cond", map.get(a64_conditions, name), 0))
        } else if starts_with(name, "[") && a64x_slot(a64x_vl_slots, mnemonic, slot) && !contains(name, ",") {
            assert(ends_with(name, "]"), "a64: invalid VL-scaled address")
            list.push_mut(result, list.of("mem_vl", a64_base(operand.text(operand.slice(arg, 1, len(text) - 1))), 0))
            list.push_mut(result, list.of("imm", 0, 0))
        } else if starts_with(name, "[") && contains(name, "mul vl") {
            assert(ends_with(name, "]"), "a64: invalid VL-scaled address")
            const parts: list = operand.split(operand.slice(arg, 1, len(text) - 1))
            assert(len(parts) == 3 && lower(trim(operand.text(list.get(parts, 2)))) == "mul vl", "a64: invalid VL-scaled address")
            list.push_mut(result, list.of("mem_vl", a64_base(operand.text(list.get(parts, 0))), 0))
            list.push_mut(result, list.of("imm", a64x_value(list.get(parts, 1), evaluate, numbers, raw, argindex), 0))
        } else if starts_with(name, "[") {
            const old: list = a64x_memory(raw, evaluate, numbers, argindex)
            for descriptor in a64x_from_legacy(list.of(old), mnemonic) {
                list.push_mut(result, descriptor)
            }
        } else if starts_with(name, "{") && ends_with(name, "}") && mnemonic == "zero" {
            const parts: list = operand.split(operand.slice(arg, 1, len(text) - 1))
            let mask: u64 = 0
            for part in parts {
                const tile: list = a64x_register(operand.text(part))
                assert(len(tile) == 2 && (list.get(tile, 0) == "za" || starts_with(list.get(tile, 0), "za_")), "a64: invalid ZA zero mask")
                const kind: string = list.get(tile, 0)
                if kind == "za" {
                    mask = 255
                } else {
                    let stride: u64 = 8
                    if kind == "za_h" {
                        stride = 4
                    }
                    if kind == "za_s" {
                        stride = 2
                    }
                    if kind == "za_d" {
                        stride = 1
                    }
                    let bit: u64 = list.get(tile, 1)
                    while bit < 8 {
                        mask = mask | (1 << bit)
                        bit = bit + (8 / stride)
                    }
                }
            }
            list.push_mut(result, list.of("za_mask", mask, 0))
        } else if starts_with(name, "{") && ends_with(name, "}") {
            list.push_mut(result, a64x_list(arg))
        } else if starts_with(name, "{") || (starts_with(name, "v") && contains(name, "[")) {
            let old: list = list.new()
            if starts_with(name, "{") {
                const pieces: list = split(text, "}")
                assert(len(pieces) == 2, "a64: invalid structure lane list")
                const end: u64 = len(list.get(pieces, 0)) + 1
                const tail: operand = a64_clean(operand.slice(arg, end, len(text)))
                old = a64_lanelist(a64_parse_regnames(operand.slice(arg, 0, end)), a64x_value(operand.slice(tail, 1, len(operand.text(tail)) - 1), evaluate, numbers, raw, argindex))
            } else {
                const pieces: list = split(name, "[")
                assert(len(pieces) == 2 && ends_with(name, "]"), "a64: invalid vector lane")
                old = a64_lane(list.get(pieces, 0), a64x_value(operand.slice(arg, len(list.get(pieces, 0)) + 1, len(text) - 1), evaluate, numbers, raw, argindex))
            }
            for descriptor in a64x_from_legacy(list.of(old), mnemonic) {
                list.push_mut(result, descriptor)
            }
        } else if a64_modifier_prefix(name) != 0 {
            const width: u64 = a64_modifier_prefix(name)
            const option: string = operand.text(operand.slice(arg, 0, width))
            let amount: integer = 0
            if len(name) > width {
                amount = a64x_value(operand.slice(arg, width, len(text)), evaluate, numbers, raw, argindex)
            } else {
                assert(width == 4, "a64: missing shift amount")
            }
            list.push_mut(result, list.of(option, amount, 0))
        } else if starts_with(name, "za.") && contains(name, "[") {
            const pieces: list = split(name, "[")
            assert(len(pieces) == 2 && ends_with(name, "]"), "a64: invalid ZA group")
            const begin: u64 = len(list.get(pieces, 0)) + 1
            const parts: list = operand.split(operand.slice(arg, begin, len(text) - 1))
            assert(len(parts) == 2 || len(parts) == 3, "a64: invalid ZA group operands")
            const select: list = a64x_register(operand.text(list.get(parts, 0)))
            assert(len(select) == 2 && list.get(select, 0) == "w", "a64: ZA selector requires W register")
            let count: u64 = 2
            if len(parts) == 3 {
                const qualifier: string = lower(trim(operand.text(list.get(parts, 2))))
                assert(qualifier == "vgx2" || qualifier == "vgx4", "a64: invalid ZA group count")
                if qualifier == "vgx4" {
                    count = 4
                }
            }
            const group: string = sym.join("za_group_", list.get(split(list.get(pieces, 0), "."), 1), count)
            list.push_mut(result, list.of(group, 0, 0))
            list.push_mut(result, list.of("w", list.get(select, 1), 0))
            list.push_mut(result, list.of("imm", a64x_value(list.get(parts, 1), evaluate, numbers, raw, argindex), 0))
        } else if a64_is_prefetch(name) {
            const old: list = a64_prefetch(name)
            list.push_mut(result, list.of("imm", list.get(old, 1), 0))
        } else if a64x_slot(a64x_fp_slots, mnemonic, slot) {
            let encoded: u64 = 0
            if evaluate {
                const floating: f64 = a64x_cached_float(numbers, raw, arg, argindex)
                encoded = list.get(a64_fp(floating), 1)
            }
            list.push_mut(result, list.of("fp", encoded, 0))
        } else if a64x_slot(a64x_zero_slots, mnemonic, slot) && contains(name, ".") {
            if evaluate {
                const floating: f64 = a64x_cached_float(numbers, raw, arg, argindex)
                assert(floating == 0.0, "a64: comparison immediate must be zero")
            }
            list.push_mut(result, list.of("fpzero", 0, 0))
        } else if a64x_slot(a64x_target_slots, mnemonic, slot) && !starts_with(name, "#") {
            const label: map = match.tokens("name:name", text)
            if map.get(label, "ok") {
                list.push_mut(result, list.of("label_target", text, 0))
            } else {
                list.push_mut(result, list.of("captured_target", a64_number(arg), 0))
            }
        } else {
            list.push_mut(result, list.of("imm", a64x_value(arg, evaluate, numbers, raw, argindex), 0))
        }
        argindex = argindex + 1
    }
    return result;
}

fn a64x_memory(raw: operand, evaluate: bool, numbers: list, argindex: u64) -> list {
    const arg: operand = a64_clean(raw)
    const text: string = operand.text(arg)
    const pre: bool = ends_with(text, "]!")
    assert(pre || ends_with(text, "]"), "a64: unterminated memory operand")
    let end: u64 = len(text) - 1
    if pre {
        end = end - 1
    }
    const parts: list = operand.split(operand.slice(arg, 1, end))
    assert(len(parts) >= 1 && len(parts) <= 3, "a64: invalid memory operand count")
    const base: string = operand.text(list.get(parts, 0))
    if len(parts) == 1 {
        assert(!pre, "a64: pre-index requires an offset")
        return a64_mem(base, 0);
    }
    const offset: operand = a64_clean(list.get(parts, 1))
    const index: string = lower(operand.text(offset))
    if contains(index, ":lo12:") {
        assert(a64_is_lo12(offset), "a64: invalid :lo12: label modifier")
        assert(!pre && len(parts) == 2, "a64: :lo12: memory offset cannot write back or use a modifier")
        if evaluate {
            return a64_mem_lo12(base, a64_lo12_name(offset));
        }
        return a64_mem(base, 0);
    }
    if map.has(a64_registers, index) {
        assert(!pre, "a64: register offset cannot write back")
        let extend: string = "lsl"
        let amount: integer = -1
        if len(parts) == 3 {
            const modifier: operand = a64_clean(list.get(parts, 2))
            const name: string = lower(operand.text(modifier))
            let width: u64 = 4
            if starts_with(name, "lsl") {
                width = 3
            }
            assert(len(name) >= width, "a64: invalid memory extend")
            extend = operand.text(operand.slice(modifier, 0, width))
            if len(name) > width {
                const separator: string = operand.text(operand.slice(modifier, width, width + 1))
                assert(trim(separator) == "" || separator == "#", "a64: invalid memory shift")
                const shift: operand = a64_number(operand.slice(modifier, width, len(name)))
                if len(trim(operand.text(shift))) > 0 {
                    amount = 0
                    if evaluate {
                        amount = a64x_cached_number(numbers, raw, shift, argindex)
                    }
                    assert(amount <= 4, "a64: invalid memory shift")
                }
            }
        } else {
            assert(list.get(a64_reg(index), 0) == 3, "a64: W index requires an extend")
        }
        return a64_index(base, index, extend, amount);
    }
    assert(len(parts) == 2, "a64: immediate offset cannot have a modifier")
    let value: integer = 0
    if evaluate {
        value = a64x_cached_number(numbers, raw, offset, argindex)
    }
    if pre {
        return a64_pre(base, value);
    }
    return a64_mem(base, value);
}
